# Public site URL, e.g. https://tijvorya.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode bypasses real authentication and must be false in production.
NEXT_PUBLIC_DEMO_MODE=false

# Supabase (required for shared production data and real authentication)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required by /api/contact; never expose it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (required for persistent video uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI — server-side only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_ENABLED=true
AI_RATE_LIMIT_PER_10_MIN=20

# Google OAuth is configured in Supabase Dashboard > Authentication > Providers > Google.
# Add both local and production callback URLs to Supabase Redirect URLs:
# http://localhost:3000/auth/callback
# https://YOUR-DOMAIN/auth/callback

# Market localization
NEXT_PUBLIC_DEFAULT_CURRENCY=ILS
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_TWITTER_HANDLE=

# Optional: contact requests are stored in Supabase after applying the v2.0 migration.
CONTACT_RATE_LIMIT_PER_15_MIN=5

# Merchant storefront domains
# Add *.tijvorya.com as a wildcard domain in your DNS/hosting provider before enabling.
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN=tijvorya.com
NEXT_PUBLIC_STOREFRONT_SUBDOMAINS=false
